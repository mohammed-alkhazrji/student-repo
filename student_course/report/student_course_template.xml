<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Template -->
    <template id="report_student_course_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Report Header -->
                        <div class="row mt-4 mb-4">
                            <div class="col-12 text-center">
                                <h2>Student Course Enrollment Report</h2>
                            </div>
                        </div>

                        <!-- Student Information -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <h4>Student Information</h4>
                                <table class="table table-sm">
                                    <tr>
                                        <td width="30%"><strong>Student Name:</strong></td>
                                        <td><span t-field="o.student_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Student ID:</strong></td>
                                        <td><span t-field="o.student_id.student_id"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Email:</strong></td>
                                        <td><span t-field="o.student_id.email"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Phone:</strong></td>
                                        <td><span t-field="o.student_id.phone"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Course Information -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <h4>Course Information</h4>
                                <table class="table table-sm">
                                    <tr>
                                        <td width="30%"><strong>Course Name:</strong></td>
                                        <td><span t-field="o.course_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Course Code:</strong></td>
                                        <td><span t-field="o.course_id.code"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Credits:</strong></td>
                                        <td><span t-field="o.course_id.credits"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Instructor:</strong></td>
                                        <td><span t-field="o.course_id.instructor"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Description:</strong></td>
                                        <td><span t-field="o.course_id.description"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Enrollment Details -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <h4>Enrollment Details</h4>
                                <table class="table table-sm">
                                    <tr>
                                        <td width="30%"><strong>Enrollment Date:</strong></td>
                                        <td><span t-field="o.enrollment_date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td><span t-field="o.status"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Grade:</strong></td>
                                        <td><span t-field="o.grade"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
