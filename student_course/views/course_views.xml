<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Course Tree View -->
    <record id="view_course_tree" model="ir.ui.view">
        <field name="name">student.course.course.tree</field>
        <field name="model">student.course.course</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="credits"/>
                <field name="instructor"/>
                <field name="enrollment_count"/>
            </tree>
        </field>
    </record>

    <!-- Course Form View -->
    <record id="view_course_form" model="ir.ui.view">
        <field name="name">student.course.course.form</field>
        <field name="model">student.course.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="credits"/>
                            <field name="instructor"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <tree>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                    <field name="grade"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Course Action -->
    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">student.course.course</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
